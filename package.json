{
  "name": "pi-discord-openclaw",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Discord bridge for Pi with OpenClaw-style streaming (reasoning/tool-progress/typed replies/follow-up), ported from pi-telegram-openclaw",
  "keywords": [
    "pi-package",
    "pi",
    "discord",
    "bot",
    "extension"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xqicxx/pi-discord-openclaw.git"
  },
  "homepage": "https://github.com/xqicxx/pi-discord-openclaw",
  "bugs": {
    "url": "https://github.com/xqicxx/pi-discord-openclaw/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-reporter=dot test/*.mjs",
    "test:verbose": "node --experimental-strip-types --test --test-reporter=spec test/*.mjs",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=peer",
    "audit:host": "npm audit",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run typecheck && npm test && npm run audit && npm run pack:check"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://github.com/llblab/pi-telegram/raw/main/screenshot.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.80.6",
    "@earendil-works/pi-ai": ">=0.80.6",
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "exports": {
    ".": "./index.ts"
  }
}
